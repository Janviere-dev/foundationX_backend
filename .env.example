# Cloudflare credentials
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=course-resources
R2_JURISDICTION=eu
BUCKET_URL=

# Parallel operation
MAX_WORKERS=3
BATCH_SIZE=50

# embedding
DEEP_INFRA_KEY=
MODEL_EMBEDDER=BAAI/bge-m3
EMBED_LIMIT=
DIMENSION=1024
STORE_SLICE_SIZE=500
EMBED_BATCH_SIZE=8
EMBED_DEVICE=cuda:0

# OCR / chunking run
OCR_WORKERS=12
OCR_LIMIT=
OCR_FILES=

# Qdrant storage run
STORE_MAX_RETRIES=3
STORE_RETRY_DELAY=5

# Qdrant Cloud Configurations
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=FoundationX
QDRANT_TIMEOUT=60
TOP_K=5

# GEMINI KEY
GOOGLE_API_KEY=
LLM_MODEL=openrouter/google/gemini-2.5-flash
LLM_MODEL_FALLBACK=gemini/gemini-2.5-flash
GOOGLE_API_KEY_FALLBACK=
LLM_ENABLED=True
ADK_SUPPRESS_GEMINI_LITELLM_WARNINGS=true
LLM_MAX_RETRIES=1
LLM_RETRY_DELAY=5
OPEN_ROUTER_KEY=

# Free direct Gemini - used when LLM_ENABLED=false
LLM_MODEL_FREE=gemini/gemini-2.5-flash
GOOGLE_API_KEY_FREE=

# Tavily web search tool
TAVILY_API_KEY=
SEARCH_DEPTH=basic

# MongoDb Cloud Configurations
MONGODB_URI=
MONGO_DB_NAME=foundationxDB
MONGO_COLLECTION_NAME=learning_contents
MONGODB_USER=
MONGODB_PASSWORD=

# Redis cache
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5
REDIS_MAX_RETRIES=3

# Quiz resumability window (Redis TTL = abandonment signal, see db/redis/save_generated_quizz.py)
QUIZ_ABANDON_TIMEOUT_SECONDS=1800

# Learning content cache TTL in minutes (cache hygiene only - Mongo keeps the lesson permanently)
LEARNING_CONTENT_EXPIRE_MINUTES=10080

# Deployment (docker-compose.yml / Traefik) - fill these in before deploying.
DOMAIN_NAME=
ACME_EMAIL=

# Firebase Config
PATH_TO_FIREBASE=foundationx_service_account.json
FIREBASE_WEB_API_KEY=
